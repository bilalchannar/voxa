rules_version = '2';

// Voxa Firestore security rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function createdAtImmutable() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['createdAt']);
    }

    function isParticipant(chat) {
      return isSignedIn() && chat != null && request.auth.uid in chat.participants;
    }

    // ---- User profile ------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && createdAtImmutable();
      allow delete: if false;

      // Allow users to access their own subcollections (settings, fcmTokens, etc.)
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---- Chats -------------------------------------------------------------
    match /chats/{chatId} {
      allow read: if isSignedIn() && (resource == null || isParticipant(resource.data));
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      // ---- Messages --------------------------------------------------------
      match /messages/{messageId} {
        allow read, create, update, delete: if isSignedIn();
      }
    }

    // ---- Calls -------------------------------------------------------------
    match /calls/{callId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.receiverId);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.callerId;

      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.receiverId);

      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.receiverId);
    }

    // ---- Status ------------------------------------------------------------
    match /status/{statusId} {
      // NOTE: reads stay open to any signed-in user on purpose. Status privacy
      // ('everyone' | 'contacts' | 'nobody') is enforced client-side because
      // the feed query orders ALL statuses by timestamp; filtering reads in
      // rules would require reshaping that query + composite indexes (out of
      // scope here). This tightens the WRITE side only, which is always safe.
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && (!('privacy' in request.resource.data)
            || request.resource.data.privacy in ['everyone', 'contacts', 'nobody']);
      allow update: if isSignedIn()
        && (
          (resource.data.uid == request.auth.uid
            && (!('privacy' in request.resource.data)
                || request.resource.data.privacy in ['everyone', 'contacts', 'nobody']))
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
        );
      allow delete: if isSignedIn() && resource.data.uid == request.auth.uid;
    }

    // Everything else is denied by default
  }
}
