rules_version = '2';

// Voxa Firestore security rules.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers -----------------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function createdAtImmutable() {
      return !request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['createdAt']);
    }

    function isParticipant(chat) {
      return isSignedIn() && chat != null && request.auth.uid in chat.participants;
    }

    // ---- User profile ------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && createdAtImmutable();
      allow delete: if false;

      // Allow users to access their own subcollections (settings, fcmTokens, etc.)
      match /settings/{settingId} {
        allow read, write: if isOwner(userId);
      }

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ---- Chats -------------------------------------------------------------
    match /chats/{chatId} {
      allow read: if isSignedIn() && (resource == null || isParticipant(resource.data));
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();

      // ---- Messages --------------------------------------------------------
      match /messages/{messageId} {
        allow read, create, update: if isSignedIn();
        allow delete: if false;
      }
    }

    // ---- Calls -------------------------------------------------------------
    match /calls/{callId} {
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.receiverId);

      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.callerId;

      allow update: if isSignedIn()
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.receiverId);

      allow delete: if isSignedIn()
        && (request.auth.uid == resource.data.callerId
            || request.auth.uid == resource.data.receiverId);
    }

    // Everything else is denied by default
  }
}
